table 'ROC Curve'
	lineageTag: 7919fae6-e2c1-5540-b274-7251243d286b
	column 'model'
		dataType: string
		sourceColumn: model
		summarizeBy: none
		lineageTag: ed76b021-5030-57df-9fbe-6beb52383da4
	column 'step'
		dataType: int64
		sourceColumn: step
		summarizeBy: sum
		lineageTag: caac8eb2-61c7-58c8-b2cb-5a91f12a5853
	column 'x_value'
		dataType: double
		sourceColumn: x_value
		summarizeBy: average
		lineageTag: 7278d486-c175-53ec-9450-d8ebedac1a64
	column 'y_value'
		dataType: double
		sourceColumn: y_value
		summarizeBy: average
		lineageTag: 549fdaa2-10ec-54f4-a990-5d8b35e55d7c

	partition 'ROC Curve' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(ProjectRoot & "/powerbi/data/ROCCurvePlot.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    TypedColumns = Table.TransformColumnTypes(PromotedHeaders, {{"model", type text},
			        {"step", Int64.Type},
			        {"x_value", type number},
			        {"y_value", type number}}, "en-US")
			in
			    TypedColumns
