table 'Confusion Matrix'
	lineageTag: aaf736ff-9dc8-5f68-860c-f2598ecb66ca
	column 'model'
		dataType: string
		sourceColumn: model
		summarizeBy: none
		lineageTag: d5b92e50-062e-5b90-872b-b2eed88a9596
	column 'actual_outcome'
		dataType: string
		sourceColumn: actual_outcome
		summarizeBy: none
		lineageTag: 12744f15-0fc5-5340-8fae-458c43aa92ce
	column 'predicted_outcome'
		dataType: string
		sourceColumn: predicted_outcome
		summarizeBy: none
		lineageTag: 64b1b09f-c5e5-5903-b713-22fa2a59c02a
	column 'customers'
		dataType: int64
		sourceColumn: customers
		summarizeBy: sum
		lineageTag: 7ed6afb7-71ad-50d9-81ce-a2f0a920525a

	partition 'Confusion Matrix' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(ProjectRoot & "/powerbi/data/ConfusionMatrix.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    TypedColumns = Table.TransformColumnTypes(PromotedHeaders, {{"model", type text},
			        {"actual_outcome", type text},
			        {"predicted_outcome", type text},
			        {"customers", Int64.Type}}, "en-US")
			in
			    TypedColumns
