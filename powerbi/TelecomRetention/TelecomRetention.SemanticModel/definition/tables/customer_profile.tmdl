	// DAX measures are kept with the main customer table so the model has no artificial helper table.
	measure 'Total Customers' = DISTINCTCOUNT('Customer Profile'[customerID])
		formatString: #,0
		displayFolder: Customer KPIs
		description: "Unique customer IDs in the current customer profile filter context."
	measure 'Churned Customers' = CALCULATE([Total Customers], 'Customer Profile'[Churn] = "Yes")
		formatString: #,0
		displayFolder: Customer KPIs
		description: "Unique customers labeled churned in the source snapshot."
	measure 'Retained Customers' = [Total Customers] - [Churned Customers]
		formatString: #,0
		displayFolder: Customer KPIs
		description: "Unique customers labeled not churned in the source snapshot."
	measure 'Observed Churn Rate' = DIVIDE([Churned Customers], [Total Customers])
		formatString: 0.0%
		displayFolder: Customer KPIs
		description: "Churned customers divided by customers after current customer filters."
	measure 'Observed Retention Rate' = DIVIDE([Retained Customers], [Total Customers])
		formatString: 0.0%
		displayFolder: Customer KPIs
		description: "Retained customers divided by customers after current customer filters."
	measure 'Average Tenure Months' = AVERAGE('Customer Profile'[tenure])
		formatString: 0.0
		displayFolder: Customer KPIs
		description: "Mean observed tenure in months for the filtered customer profile."
	measure 'Average Monthly Charges' = AVERAGE('Customer Profile'[MonthlyCharges])
		formatString: 0.00
		displayFolder: Customer KPIs
		description: "Mean MonthlyCharges; the source does not specify a currency code."
	measure 'Average Monthly Charges among Churned' = CALCULATE(AVERAGE('Customer Profile'[MonthlyCharges]), 'Customer Profile'[Churn] = "Yes")
		formatString: 0.00
		displayFolder: Commercial Exposure
		description: "Descriptive mean charge among rows labeled churned; not a realized loss."
	measure 'Monthly Charges Associated with Churned Customers' = CALCULATE(SUM('Customer Profile'[MonthlyCharges]), 'Customer Profile'[Churn] = "Yes")
		formatString: #,0.00
		displayFolder: Commercial Exposure
		description: "Sum of observed monthly charges for churn-labeled customers; not proven future revenue loss."
	measure 'Churn Contribution to Filtered Total' = DIVIDE([Churned Customers], CALCULATE([Churned Customers], ALLSELECTED('Customer Profile')))
		formatString: 0.0%
		displayFolder: Segment Analysis
		description: "Segment churn count divided by total churn count under the outer report selection."
	measure 'Holdout Test Customers' = DISTINCTCOUNT('Holdout Scores'[customerID])
		formatString: #,0
		displayFolder: Model Evaluation
		description: "Unique customers in the fixed held-out test split."
	measure 'Holdout Churned Customers' = CALCULATE([Holdout Test Customers], 'Holdout Scores'[Churn] = "Yes")
		formatString: #,0
		displayFolder: Model Evaluation
		description: "Observed churn labels in the fixed test split."
	measure 'Holdout Observed Churn Rate' = DIVIDE([Holdout Churned Customers], [Holdout Test Customers])
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Observed churn prevalence in the fixed test split; not recalculated by the model."
	measure 'Holdout High Risk Customers' = CALCULATE([Holdout Test Customers], 'Holdout Scores'[risk_tier] IN {"High", "Critical"})
		formatString: #,0
		displayFolder: Model Evaluation
		description: "Held-out customers assigned High or Critical risk tiers by the existing scoring export."
	measure 'Average Holdout Churn Probability' = AVERAGE('Holdout Scores'[churn_probability])
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Mean predicted probability across the fixed held-out test split or selected risk tier."
	measure 'Holdout Predicted Positive Customers' = CALCULATE([Holdout Test Customers], 'Holdout Scores'[predicted_churn] = 1)
		formatString: #,0
		displayFolder: Model Evaluation
		description: "Held-out cases classified positive at the model's documented threshold."
	measure 'XGBoost ROC AUC' = CALCULATE(MAX('Model Metrics'[roc_auc]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.000
		displayFolder: Model Evaluation
		description: "Fixed test-set ROC-AUC from the authoritative model output."
	measure 'XGBoost Average Precision' = CALCULATE(MAX('Model Metrics'[pr_auc_average_precision]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.000
		displayFolder: Model Evaluation
		description: "Fixed test-set average precision from the authoritative model output."
	measure 'XGBoost Precision' = CALCULATE(MAX('Model Metrics'[precision]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Fixed test-set precision at the threshold selected from training OOF predictions."
	measure 'XGBoost Recall' = CALCULATE(MAX('Model Metrics'[recall]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Fixed test-set recall at the threshold selected from training OOF predictions."
	measure 'XGBoost F1' = CALCULATE(MAX('Model Metrics'[f1]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.000
		displayFolder: Model Evaluation
		description: "Fixed test-set F1 at the threshold selected from training OOF predictions."
	measure 'XGBoost Accuracy' = CALCULATE(MAX('Model Metrics'[accuracy]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Fixed test-set accuracy; interpret alongside class balance and confusion matrix."
	measure 'XGBoost Threshold' = CALCULATE(MAX('Model Metrics'[threshold]), 'Model Metrics'[model] = "xgboost")
		formatString: 0.00
		displayFolder: Model Evaluation
		description: "Classification threshold chosen from five-fold out-of-fold training predictions."
	measure 'XGBoost Evaluation Size' = CALCULATE(MAX('Model Metrics'[evaluation_size]), 'Model Metrics'[model] = "xgboost")
		formatString: #,0
		displayFolder: Model Evaluation
		description: "Number of cases in the fixed test evaluation."
	measure 'ROC Curve True Positive Rate' = AVERAGE('ROC Curve'[y_value])
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Empirical held-out true-positive rate at each false-positive-rate coordinate."
	measure 'Precision Recall Curve Precision' = AVERAGE('Precision Recall Curve'[y_value])
		formatString: 0.0%
		displayFolder: Model Evaluation
		description: "Empirical held-out precision at each recall coordinate; repeated coordinates are collapsed for plotting."
	measure 'Mean Absolute SHAP' = AVERAGE('Feature Importance'[mean_abs_shap])
		formatString: 0.000
		displayFolder: Model Interpretation
		description: "Mean absolute SHAP value from the fitted XGBoost booster, in raw-margin units."
	measure 'Hypothetical Gross Charges' = SUM('Retention Scenario'[gross_charges_over_assumed_months_hypothetical])
		formatString: #,0.00
		displayFolder: Scenario Analysis
		description: "Illustrative charge arithmetic under the CSV assumptions; not revenue, profit, savings, or measured retention."

	partition 'Customer Profile' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(ProjectRoot & "/powerbi/data/CustomerReport.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    TypedColumns = Table.TransformColumnTypes(PromotedHeaders, {{"customerID", type text},
			        {"gender", type text},
			        {"SeniorCitizen", Int64.Type},
			        {"Partner", type text},
			        {"Dependents", type text},
			        {"tenure", Int64.Type},
			        {"PhoneService", type text},
			        {"MultipleLines", type text},
			        {"InternetService", type text},
			        {"OnlineSecurity", type text},
			        {"OnlineBackup", type text},
			        {"DeviceProtection", type text},
			        {"TechSupport", type text},
			        {"StreamingTV", type text},
			        {"StreamingMovies", type text},
			        {"Contract", type text},
			        {"PaperlessBilling", type text},
			        {"PaymentMethod", type text},
			        {"MonthlyCharges", type number},
			        {"TotalCharges", type number},
			        {"Churn", type text},
			        {"Churn_Flag", Int64.Type},
			        {"tenure_band", type text},
			        {"MonthlyChargeBand", type text},
			        {"ServiceCombination", type text},
			        {"tenure_band_order", Int64.Type},
			        {"risk_tier_order", Int64.Type},
			        {"churn_probability", type number},
			        {"predicted_churn", Int64.Type},
			        {"risk_tier", type text},
			        {"model_identifier", type text},
			        {"data_split", type text}}, "en-US")
			in
			    TypedColumns
